<?xml version="1.0"?>
<!--
  Ackermann mobile manipulator: F1Tenth-style chassis + Open Manipulator-X arm.

  This is a placeholder. On the Linux side, compose by including the two
  upstream xacro files and connecting them with a fixed joint:

    <xacro:include filename="$(find f1tenth_description)/urdf/racecar.xacro" />
    <xacro:include filename="$(find open_manipulator_description)/urdf/open_manipulator_robot.urdf.xacro" />

    <joint name="arm_mount" type="fixed">
      <parent link="base_link" />
      <child  link="link1" />
      <origin xyz="0.15 0 0.20" rpy="0 0 0" />
    </joint>

  The wheelbase and max steering angle should match the Hybrid A* config
  (default wheelbase = 0.32m for F1Tenth, max_steering_angle = 0.34 rad).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_mobile_manipulator">
  <link name="base_link" />
  <!-- TODO(linux): include f1tenth + open_manipulator xacros and connect them. -->
</robot>
