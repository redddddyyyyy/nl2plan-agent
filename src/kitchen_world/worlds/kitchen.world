<?xml version="1.0" ?>
<!--
  Kitchen world for the NL2Plan demo.

  Layout:
    - Ground plane, ambient light
    - Table at (5.5, 2.5) with a red mug on top
    - Chairs at (3.5, 1.0), (3.5, 3.5), (4.5, 1.5), (4.5, 3.0) as obstacles
    - Robot spawn at (0, 0)

  Replace this stub with a real SDF on the Linux side. Start from
  turtlebot3_gazebo/worlds/turtlebot3_house.world for a populated room.
-->
<sdf version="1.7">
  <world name="kitchen">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- TODO(linux): include kitchen room model, table, chairs, red_mug. -->
    <!-- Example chair placement once models are imported:
    <include>
      <name>chair_1</name>
      <pose>3.5 1.0 0 0 0 0</pose>
      <uri>model://chair</uri>
    </include>
    -->
  </world>
</sdf>
